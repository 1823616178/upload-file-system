# FTP 配置
NUXT_FTP_HOST=<FTP 服务器地址>
NUXT_FTP_USER=<FTP 用户名>
NUXT_FTP_PASSWORD=<FTP 密码>
NUXT_FTP_PORT=21
NUXT_FTP_SECURE=false
NUXT_FTP_BASE_PATH=/static/zhonghuaguji/wenjinyangji

# 数据库配置
NUXT_DB_HOST=<数据库地址>
NUXT_DB_PORT=3306
NUXT_DB_USER=<数据库用户名>
NUXT_DB_PASSWORD=<数据库密码>
NUXT_DB_NAME=hanvon_tools_database

# 对外开放接口访问密钥（可选，多个密钥用英文逗号分隔，支持 "名称:密钥" 格式）
# 示例：NUXT_API_KEYS=erp:sk_live_xxx,ocr:sk_live_yyy
NUXT_API_KEYS=

# 种子数据（npm run typeorm:seed 使用）
SEED_USERNAME=hccloud
SEED_PASSWORD=<种子用户密码，必填>
